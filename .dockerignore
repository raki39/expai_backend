# Segredo nunca entra na imagem. As linhas por servico acima ja cobrem
# os tres que existem; estas cobrem o servico que alguem criar depois.
**/.env
**/.env.*
!**/.env.example

**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/*.sqlite3
**/*.sqlite3-wal
**/*.sqlite3-shm
