# Fase 0A - servico `api`
#
# APENAS SEGREDOS E BOOTSTRAP moram aqui (ADR 0008).
# Os parametros do experimento (mercado, timeframe, taxas, tetos, cambio,
# B1, B3, tiers, tabela de precos) vivem no banco, versionados, e sao
# editaveis pelo painel. Nao os coloque aqui: eles serao ignorados.
#
# Copie para .env e preencha. NUNCA versione o .env.

# ---------------------------------------------------------------- bootstrap
# `railway` torna API_SERVICE_TOKEN obrigatorio e exige DB_PATH absoluto.
APP_ENV=local

# Injetada pela Railway em producao. Local, escolha uma porta livre.
PORT=8000

# CAMINHO ABSOLUTO em producao: /data/fase0a.sqlite3
# O volume da Railway e montado no START do container, nunca no build.
DB_PATH=./var/fase0a.sqlite3

# CAMINHO ABSOLUTO em producao: /data/datasets
DATA_DIR=./var/datasets

LOG_LEVEL=INFO

# ---------------------------------------------------------------- segredos
# Token que o servico `web` (na Vercel) apresenta para falar com a `api`.
# NUNCA chega ao navegador: vive no servidor Next.js.
# Obrigatorio quando APP_ENV=railway.
#
# ATENCAO (ADR 0010): a api tem dominio publico, porque a Vercel nao alcanca
# a rede privada da Railway. Este token e a UNICA tranca entre a internet e
# os endpoints que gastam token de LLM. Minimo 32 bytes url-safe:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SERVICE_TOKEN=

# Chaves de LLM. Nunca vao para o banco, nunca aparecem em log ou no painel.
# Defina TAMBEM um teto de gasto mensal em cada chave, no painel do provedor:
# o limite tem de morar fora do codigo (secao 12.1 do documento).
#
# Sao chaves de API (console do provedor), e nao assinatura de produto. A
# ANTHROPIC_API_KEY e a que o tier `padrao` usa; a OPENAI_API_KEY existe para
# o segundo provedor exigido pela secao 3.9 e so e exercitada para provar
# viabilidade - o experimento nao roda nela.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --------------------------------------------- so para fechar o criterio 7b
# Os testes marcados `rede` sao PULADOS a menos que estas existam. Sao nomes
# separados de proposito: rodar a suite nao pode gastar dinheiro por descuido,
# e uma chave que esta no .env para a aplicacao usar nao deve autorizar a
# suite a gastar sozinha.
#   ANTHROPIC_API_KEY_REAL=
#   OPENAI_API_KEY_REAL=
#   OPENAI_MODEL_REAL=gpt-5.6-luna

# -------------------------------------------------------------------- CORS
# Origens de navegador liberadas, separadas por virgula. VAZIO = desligado.
#
# Com o padrao atual (o painel faz proxy no servidor Next.js) o navegador NAO
# chama esta api direto, e portanto CORS nao e exercitado - deixe vazio.
#
# Preencha apenas se o navegador passar a chamar a api diretamente:
#   CORS_ALLOWED_ORIGINS=https://seu-painel.vercel.app,http://localhost:3000
#
# NUNCA use "*": esta api exige credencial em toda rota, e curinga com
# credencial e invalido no protocolo. Lembre tambem que CORS nao autentica
# nada - e politica do navegador sobre LER a resposta.
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------- limite inviolavel
# Teto superior de gasto por run, em USD. A configuracao do banco NAO pode
# exceder este valor: uma config_version que tente e recusada (secao 12.1).
# Nao e o teto operacional - esse fica na config versionada, no painel.
LLM_MAX_USD_ABSOLUTE=5.00
