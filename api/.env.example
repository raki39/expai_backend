# Fase 0A - servico `api`
#
# APENAS SEGREDOS E BOOTSTRAP moram aqui (ADR 0008).
# Os parametros do experimento (mercado, timeframe, taxas, tetos, cambio,
# B1, B3, tiers, tabela de precos) vivem no banco, versionados, e sao
# editaveis pelo painel. Nao os coloque aqui: eles serao ignorados.
#
# Copie para .env e preencha. NUNCA versione o .env.

# ---------------------------------------------------------------- bootstrap
# `railway` torna API_SERVICE_TOKEN obrigatorio e exige DB_PATH absoluto.
APP_ENV=local

# Injetada pela Railway em producao. Local, escolha uma porta livre.
PORT=8000

# CAMINHO ABSOLUTO em producao: /data/fase0a.sqlite3
# O volume da Railway e montado no START do container, nunca no build.
DB_PATH=./var/fase0a.sqlite3

# CAMINHO ABSOLUTO em producao: /data/datasets
DATA_DIR=./var/datasets

LOG_LEVEL=INFO

# ---------------------------------------------------------------- segredos
# Token que o servico `web` apresenta para falar com a `api`.
# NUNCA chega ao navegador: vive no servidor Next.js.
# Obrigatorio quando APP_ENV=railway.
API_SERVICE_TOKEN=

# Chaves de LLM. Nunca vao para o banco, nunca aparecem em log ou no painel.
# Defina TAMBEM um teto de gasto mensal em cada chave, no painel do provedor:
# o limite tem de morar fora do codigo (secao 12.1 do documento).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------- limite inviolavel
# Teto superior de gasto por run, em USD. A configuracao do banco NAO pode
# exceder este valor: uma config_version que tente e recusada (secao 12.1).
# Nao e o teto operacional - esse fica na config versionada, no painel.
LLM_MAX_USD_ABSOLUTE=5.00
