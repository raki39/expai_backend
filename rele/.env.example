# Fase 0C - servico `rele` (ADR 0029).
#
# TRES obrigatorias, e o start recusa subir sem qualquer uma delas.

# Dominio PUBLICO da api. O rele fala com ela pela internet, porque os dois
# estao em REGIOES DIFERENTES - o rele em Singapura (US East da 451 na
# Binance), a api em US East (onde o volume com o ledger mora, e migra-lo era
# o risco que a alternativa A evitou).
RELE_API_URL=https://sua-api.up.railway.app

# O MESMO valor da api. Autentica QUEM chama.
API_SERVICE_TOKEN=

# O MESMO valor da api, e DIFERENTE do token acima. Assina O QUE e enviado.
#
# Sao dois segredos de proposito: um deixa ler o painel, o outro deixa
# ESCREVER no fluxo. Reusar o mesmo faria o comprometimento de um dar o outro.
RELE_HMAC_SECRET=

RELE_SIMBOLO=BTCUSDT
RELE_TIMEFRAME=15m
RELE_VENUE=binance
