# Fase 0C - servico `coletor` (ADR 0028).
#
# TRES variaveis, e so. Este servico nao chama LLM, nao serve HTTP e nao tem
# banco - entao ele NAO recebe ANTHROPIC_API_KEY, OPENAI_API_KEY,
# API_SERVICE_TOKEN, LLM_MAX_USD_ABSOLUTE, DATA_DIR, CORS_ALLOWED_ORIGINS nem
# PORT. Dar credencial a um servico que nao a usa amplia superficie de
# vazamento de graca, e a regra 15 existe justamente para isso.

# OBRIGATORIA. Com `railway`, o pre-voo RECUSA subir sem volume montado em
# COLETOR_DIR - porque escrever com sucesso nao e persistir, e sem volume o
# coletor perde tudo no redeploy sem erro nenhum.
APP_ENV=local

# Volume PROPRIO, caminho absoluto. Tem de bater com o mount path do volume.
# Nunca o /data do servico `api`: o SQLite do experimento tem escritor unico
# (D44), e o coletor nao encosta nele.
COLETOR_DIR=/dados

# Opcional - este e o default.
COLETOR_SIMBOLO=btcusdt

# ---------------------------------------------------------------- DB_PATH
# OPCIONAL, e o unico que exige explicacao.
#
# Ele nao configura nada aqui: serve so para o pre-voo comparar COLETOR_DIR com
# o diretorio do banco do experimento e RECUSAR o boot se colidirem.
#
#   Na Railway:  NAO defina. Os dois servicos tem volumes separados por
#                construcao, e a colisao que a guarda procura nao pode ocorrer.
#
#   Localmente:  DEFINA se quiser a guarda armada. Num compose mal configurado
#                alguem pode apontar os dois para o mesmo caminho, e ai e
#                melhor falhar no boot com mensagem clara.
#
# DB_PATH=/data/fase0a.sqlite3
