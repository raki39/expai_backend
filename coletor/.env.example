# Fase 0C - servico `coletor` (ADR 0028).

# `railway` RECUSA subir sem volume montado em COLETOR_DIR. Sem isso o coletor
# grava em disco efemero e perde tudo no redeploy, em silencio.
APP_ENV=local

# Volume PROPRIO. Nunca o /data do servico `api`: o SQLite do experimento tem
# escritor unico (D44), e o coletor nao encosta nele.
COLETOR_DIR=/dados

COLETOR_SIMBOLO=btcusdt

# NAO defina DB_PATH aqui. Ele existe so para o pre-voo detectar colisao com o
# volume do experimento e recusar o boot.
